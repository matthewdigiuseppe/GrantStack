#!/usr/bin/env bash
# grantstack-upgrade — pull the latest GrantStack into this clone.
#
# Pulling updates the files; Claude Code still has to reload them. How depends
# on how the skills were registered:
#   * installed from GitHub  -> /plugin marketplace update grantstack
#   * installed from this clone -> /plugin marketplace update grantstack (it
#     re-reads this directory), or reinstall with /plugin install grantstack@grantstack
# Either way, restart Claude Code afterwards so the reloaded skills take effect.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GS_ROOT="$(cd "$HERE/.." && pwd)"

if [[ ! -d "$GS_ROOT/.git" ]]; then
  echo "GrantStack root at $GS_ROOT is not a git checkout; cannot upgrade." >&2
  echo "For a marketplace install, run: /plugin marketplace update grantstack" >&2
  exit 1
fi

if [[ -n "$(git -C "$GS_ROOT" status --porcelain)" ]]; then
  echo "GrantStack checkout at $GS_ROOT has local changes; commit or stash them first." >&2
  exit 1
fi

before="$(git -C "$GS_ROOT" rev-parse --short HEAD)"
version_before="$(grep -o '"version": "[^"]*"' "$GS_ROOT/.claude-plugin/plugin.json" | head -1 | cut -d'"' -f4)"

echo "Pulling latest GrantStack into $GS_ROOT..."
git -C "$GS_ROOT" pull --ff-only

after="$(git -C "$GS_ROOT" rev-parse --short HEAD)"
version_after="$(grep -o '"version": "[^"]*"' "$GS_ROOT/.claude-plugin/plugin.json" | head -1 | cut -d'"' -f4)"

if [[ "$before" == "$after" ]]; then
  echo "Already up to date at $after (version $version_after)."
  exit 0
fi

echo ""
echo "Updated $before -> $after (version $version_before -> $version_after)."
echo "Skills changed:"
git -C "$GS_ROOT" diff --name-only "$before" "$after" -- skills references \
  | sed 's|^|  |' || true
echo ""
echo "Re-running setup (PATH and permissions)..."
"$GS_ROOT/setup"

echo ""
echo "Now reload the skills in Claude Code:"
echo "  /plugin marketplace update grantstack"
echo "then restart Claude Code."
